# ===== LLM API 配置（必填）=====
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://apihub.agnes-ai.com/v1
LLM_MODEL=agnes-2.0-flash
# 可用模型列表(逗号分隔,供前端多模型切换下拉使用)
LLM_AVAILABLE_MODELS=agnes-2.0-flash,agnes-2.0-pro,gpt-4o,claude-3-5-sonnet

# ===== 前端域名（CORS 白名单，部署后替换为实际 Vercel 地址）=====
FRONTEND_URL=https://flowgenie.vercel.app

# ===== 邮件凭证（在凭证面板配置，或直接填此处）=====
# 用于 send_email 工具发送邮件
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_password

# ===== IM 推送凭证（在凭证面板配置，或直接填此处）=====
# 企业微信机器人 Webhook URL（用于 send_wechat 工具）
WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_key
# Slack Webhook URL（用于 send_slack 工具）
SLACK_WEBHOOK=https://hooks.slack.com/services/your/slack/webhook
# 钉钉机器人 Webhook URL（用于 send_dingtalk 工具）
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your_token
# Telegram Bot Token（用于 send_telegram 工具）
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Telegram Chat ID（用于 send_telegram 工具推送目标)
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ===== 开发工具凭证（在凭证面板配置，或直接填此处）=====
# GitHub Token（用于 github_api 工具，访问私有仓库或提高速率限制）
GITHUB_TOKEN=ghp_your_github_token

# ===== 数据库凭证（在凭证面板配置，或直接填此处）=====
# 数据库连接串（用于 database_query 工具）
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ===== Notion / 飞书 / 通知（在凭证面板配置，或直接填此处）=====
# Notion 集成 Token（用于 notion_api 工具写入 Notion 数据库）
NOTION_TOKEN=secret_your_notion_integration_token
# 飞书机器人 Webhook URL（用于 feishu_api 工具推送消息）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your_hook_id
# 失败通知收件邮箱（工作流失败时邮件通知收件人，依赖 SMTP 配置）
FAILURE_NOTIFY_EMAIL=your_email@example.com

# ===== 安全配置 =====
# API Key 认证(留空则本地开发放行所有请求;部署时必须设置)
# 前端请求需在 Header 携带 X-API-Key: <此值>
FLOWGENIE_API_KEY=
# Admin Token(用于 /api/credentials 写操作 PUT/DELETE/POST test;留空则本地开发放行)
# 前端请求需在 Header 携带 X-Admin-Token: <此值>
FLOWGENIE_ADMIN_TOKEN=

# ===== 可观测性 =====
# JSON 结构化日志(生产推荐开启:1/true/yes;留空或 0 用文本格式)
LOG_FORMAT_JSON=
# LLM 调用超时(秒,默认 60,避免长尾请求长期占用并发槽位)
LLM_TIMEOUT=60

# ===== 性能调优 =====
# 工具执行默认超时(秒,默认 120,上限 300);单步可通过 step.params.timeout 覆盖
# 流式 LLM 调用自动放宽至 300s(token 持续到达不算挂起)
TOOL_TIMEOUT=120
# 工作流最大并发执行数(信号量控制,默认 5)
WORKFLOW_MAX_CONCURRENT=5
